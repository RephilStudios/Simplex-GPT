# Copy to .env and adjust. Every value has a sensible default in docker-compose.yml.

# Base image with a PyTorch+CUDA build that works on the DGX Spark (aarch64 + Blackwell).
# This is the one thing to confirm per-machine — pick a tag that exists and supports the Spark.
BASE_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3

# Host path to the Qwen3.5-35B-A3B weights (mounted read-only into the container).
MODEL_PATH=./models/Qwen3.5-35B-A3B

# Port the IDE connects to.
PORT=8100

# Optional shared HF cache (restarts skip re-fetching the tokenizer/processor).
HF_CACHE=./hf-cache
